rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // ============================================
    // FUNCIONES AUXILIARES
    // ============================================
    
    // Verifica si el usuario está autenticado
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Verifica si el archivo es una imagen válida
    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }
    
    // Verifica el tamaño del archivo (máximo 5MB)
    function isValidSize() {
      return request.resource.size < 5 * 1024 * 1024;
    }
    
    // Verifica si el email es de un administrador
    function isAdminEmail() {
      return isSignedIn() && (
        request.auth.token.email == 'samugutibarona@gmail.com' ||
        request.auth.token.email == 'merakiaca.c@gmail.com'
      );
    }
    
    // ============================================
    // IMÁGENES DE PRODUCTOS
    // ============================================
    match /products/{productId}/{allPaths=**} {
      // Todos pueden leer las imágenes de productos
      allow read: if true;
      
      // Solo admins pueden subir, actualizar o eliminar imágenes de productos
      allow write: if isAdminEmail() && isImage() && isValidSize();
    }
    
    // ============================================
    // IMÁGENES DE TELAS/PATRONES
    // ============================================
    match /fabrics/{fabricId}/{allPaths=**} {
      // Todos pueden leer las imágenes de telas
      allow read: if true;
      
      // Solo admins pueden subir, actualizar o eliminar imágenes de telas
      allow write: if isAdminEmail() && isImage() && isValidSize();
    }
    
    // ============================================
    // IMÁGENES DE USUARIOS (avatares)
    // ============================================
    match /users/{userId}/{allPaths=**} {
      // Todos pueden leer avatares de usuarios
      allow read: if true;
      
      // Los usuarios pueden subir su propio avatar
      allow write: if isSignedIn() && 
                     request.auth.uid == userId && 
                     isImage() && 
                     isValidSize();
    }
    
    // ============================================
    // OTRAS IMÁGENES (categorías, banners, etc.)
    // ============================================
    match /categories/{categoryId}/{allPaths=**} {
      // Todos pueden leer
      allow read: if true;
      
      // Solo admins pueden escribir
      allow write: if isAdminEmail() && isImage() && isValidSize();
    }
    
    match /banners/{bannerId}/{allPaths=**} {
      // Todos pueden leer
      allow read: if true;
      
      // Solo admins pueden escribir
      allow write: if isAdminEmail() && isImage() && isValidSize();
    }
    
    // ============================================
    // REGLA POR DEFECTO: DENEGAR TODO
    // ============================================
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
