# Firebase Config
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Mercado Pago
VITE_MERCADOPAGO_PUBLIC_KEY=your_mercadopago_public_key
VITE_MERCADOPAGO_SUCCESS_URL=http://localhost:5173/orden/success
VITE_MERCADOPAGO_FAILURE_URL=http://localhost:5173/orden/failure
VITE_MERCADOPAGO_PENDING_URL=http://localhost:5173/orden/pending

# Admin Emails (separados por comas)
VITE_ADMIN_EMAILS=admin@merakiaca.com,tu-email@gmail.com
